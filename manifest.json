{
  "manifest_version": 3,
  "name": "LinkedIn AutoApply",
  "version": "1.6.0",
  "description": "Auto-apply to LinkedIn Easy Apply jobs using Mistral AI for smart question answering.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "activeTab",
    "scripting",
    "notifications",
    "offscreen",
    "downloads"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://api.mistral.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/jobs/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "LinkedIn AutoApply",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": ["tesseract-worker.js"],
      "matches": ["https://www.linkedin.com/*"]
    }
  ]
}
